{
  "$description": "Дизайн-токены «Фьюжн». Единый источник для сайта (tokens.css генерируется из этого файла) и мобильного приложения (Style Dictionary → iOS/Android). Формат близок к W3C Design Tokens: $value, $type. Ссылки — {group.name}.",
  "palette": {
    "$type": "color",
    "red":     { "50": "#FDECEC", "100": "#FAD3D4", "200": "#F5A7A9", "300": "#F07A7E", "400": "#EA454A", "500": "#E41E23", "600": "#C8161B", "700": "#A31015", "800": "#7A0C10" },
    "nori":    { "0": "#FFFFFF", "50": "#F8F8F6", "100": "#F1F2F0", "200": "#E3E6E3", "300": "#C9CDCA", "400": "#A3A9A5", "500": "#747B76", "600": "#5A615C", "700": "#3E4540", "800": "#2C322E", "850": "#262B28", "900": "#1F2421", "950": "#141715" },
    "salmon":  { "100": "#FFE8DD", "300": "#FFB38A", "400": "#FF8A5B", "700": "#A3401A" },
    "avocado": { "100": "#EEF5DF", "300": "#B9D67A", "500": "#8DB33A", "800": "#47621A" },
    "ginger":  { "100": "#FFF4D6", "300": "#F6CF79", "500": "#F2B33D", "800": "#7A5300" },
    "green":   { "100": "#E6F4EA", "300": "#6FCF8E", "700": "#276B3C", "900": "#183222" },
    "amber":   { "100": "#FFF3DC", "300": "#F0B65A", "700": "#9A5B00", "900": "#33280F" },
    "crimson": { "100": "#FDECEA", "300": "#FF8A80", "700": "#B3261E", "900": "#3A1A18" },
    "blue":    { "100": "#E6EEF8", "300": "#8AB8EA", "700": "#2563A8", "900": "#172636" }
  },
  "theme": {
    "$type": "color",
    "light": {
      "bg": "{palette.nori.0}",
      "bg-subtle": "{palette.nori.50}",
      "surface": "{palette.nori.0}",
      "surface-raised": "{palette.nori.0}",
      "surface-sunken": "{palette.nori.100}",
      "border": "{palette.nori.200}",
      "border-strong": "{palette.nori.300}",
      "border-input": "{palette.nori.500}",
      "text": "{palette.nori.900}",
      "text-muted": "{palette.nori.600}",
      "text-subtle": "{palette.nori.500}",
      "text-inverse": "{palette.nori.0}",
      "brand": "{palette.red.500}",
      "brand-hover": "{palette.red.600}",
      "brand-active": "{palette.red.700}",
      "brand-soft": "{palette.red.50}",
      "brand-text": "{palette.red.600}",
      "on-brand": "{palette.nori.0}",
      "ink": "{palette.nori.900}",
      "on-ink": "{palette.nori.0}",
      "focus": "{palette.red.500}",
      "success": "{palette.green.700}", "success-soft": "{palette.green.100}",
      "warning": "{palette.amber.700}", "warning-soft": "{palette.amber.100}",
      "error": "{palette.crimson.700}", "error-soft": "{palette.crimson.100}",
      "info": "{palette.blue.700}", "info-soft": "{palette.blue.100}",
      "overlay": "rgba(20, 23, 21, 0.56)",
      "skeleton": "{palette.nori.100}",
      "tag-hit-bg": "{palette.salmon.100}", "tag-hit-fg": "{palette.salmon.700}",
      "tag-new-bg": "{palette.ginger.100}", "tag-new-fg": "{palette.ginger.800}",
      "tag-spicy-bg": "{palette.red.50}", "tag-spicy-fg": "{palette.red.700}",
      "tag-veg-bg": "{palette.avocado.100}", "tag-veg-fg": "{palette.avocado.800}",
      "progress-cold": "#5FA8B8",
      "progress-hot": "{palette.red.500}",
      "progress-track": "{palette.nori.100}"
    },
    "dark": {
      "bg": "{palette.nori.950}",
      "bg-subtle": "{palette.nori.900}",
      "surface": "{palette.nori.900}",
      "surface-raised": "{palette.nori.850}",
      "surface-sunken": "{palette.nori.950}",
      "border": "{palette.nori.800}",
      "border-strong": "{palette.nori.700}",
      "border-input": "{palette.nori.500}",
      "text": "{palette.nori.100}",
      "text-muted": "{palette.nori.400}",
      "text-subtle": "{palette.nori.500}",
      "text-inverse": "{palette.nori.900}",
      "brand": "{palette.red.500}",
      "brand-hover": "{palette.red.600}",
      "brand-active": "{palette.red.700}",
      "brand-soft": "#3A1C1D",
      "brand-text": "{palette.red.300}",
      "on-brand": "{palette.nori.0}",
      "ink": "{palette.nori.100}",
      "on-ink": "{palette.nori.900}",
      "focus": "{palette.red.300}",
      "success": "{palette.green.300}", "success-soft": "{palette.green.900}",
      "warning": "{palette.amber.300}", "warning-soft": "{palette.amber.900}",
      "error": "{palette.crimson.300}", "error-soft": "{palette.crimson.900}",
      "info": "{palette.blue.300}", "info-soft": "{palette.blue.900}",
      "overlay": "rgba(0, 0, 0, 0.64)",
      "skeleton": "{palette.nori.850}",
      "tag-hit-bg": "#3B2318", "tag-hit-fg": "{palette.salmon.300}",
      "tag-new-bg": "#3A2E12", "tag-new-fg": "{palette.ginger.300}",
      "tag-spicy-bg": "#3A1C1D", "tag-spicy-fg": "{palette.red.300}",
      "tag-veg-bg": "#243015", "tag-veg-fg": "{palette.avocado.300}",
      "progress-cold": "#7CC3D2",
      "progress-hot": "{palette.red.400}",
      "progress-track": "{palette.nori.800}"
    }
  },
  "font": {
    "$type": "fontFamily",
    "display": "'Cormorant Garamond', 'Cormorant', Georgia, 'Times New Roman', serif",
    "body": "'Golos Text', 'Segoe UI', Roboto, system-ui, -apple-system, sans-serif",
    "mono": "ui-monospace, 'SF Mono', Consolas, monospace"
  },
  "text": {
    "$description": "min — мобильный 375 px, max — десктоп 1440 px; в CSS между ними плавно через clamp().",
    "display":    { "family": "display", "weight": 700, "min": 40, "max": 64, "lineHeight": 1.0,  "tracking": "-0.01em" },
    "h1":         { "family": "display", "weight": 700, "min": 34, "max": 52, "lineHeight": 1.05, "tracking": "-0.01em" },
    "h2":         { "family": "display", "weight": 700, "min": 28, "max": 40, "lineHeight": 1.1,  "tracking": "0" },
    "h3":         { "family": "display", "weight": 700, "min": 24, "max": 30, "lineHeight": 1.15, "tracking": "0" },
    "h4":         { "family": "body", "weight": 600, "min": 18, "max": 20, "lineHeight": 1.3,  "tracking": "0" },
    "body-lg":    { "family": "body", "weight": 400, "min": 17, "max": 18, "lineHeight": 1.55, "tracking": "0" },
    "body":       { "family": "body", "weight": 400, "min": 15, "max": 16, "lineHeight": 1.5,  "tracking": "0" },
    "body-sm":    { "family": "body", "weight": 400, "min": 14, "max": 14, "lineHeight": 1.45, "tracking": "0" },
    "caption":    { "family": "body", "weight": 500, "min": 12, "max": 13, "lineHeight": 1.35, "tracking": "0" },
    "overline":   { "family": "body", "weight": 600, "min": 12, "max": 12, "lineHeight": 1.2,  "tracking": "0.08em", "transform": "uppercase" },
    "button":     { "family": "body", "weight": 600, "min": 15, "max": 16, "lineHeight": 1.0,  "tracking": "0" },
    "price-sm":   { "family": "body", "weight": 600, "min": 15, "max": 15, "lineHeight": 1.2,  "tracking": "0", "numeric": "tabular-nums" },
    "price":      { "family": "body", "weight": 600, "min": 18, "max": 20, "lineHeight": 1.2,  "tracking": "0", "numeric": "tabular-nums" },
    "price-lg":   { "family": "body", "weight": 600, "min": 24, "max": 28, "lineHeight": 1.1,  "tracking": "-0.01em", "numeric": "tabular-nums" },
    "price-total":{ "family": "body", "weight": 700, "min": 28, "max": 32, "lineHeight": 1.1,  "tracking": "-0.01em", "numeric": "tabular-nums" }
  },
  "space": { "$type": "dimension", "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64, "20": 80, "24": 96 },
  "radius": { "$type": "dimension", "xs": 4, "sm": 6, "md": 10, "lg": 14, "xl": 20, "pill": 999 },
  "border": { "$type": "dimension", "hairline": 1, "thick": 2, "focus": 2 },
  "shadow": {
    "$type": "shadow",
    "light": { "sm": "0 1px 2px rgba(20,23,21,.08)", "md": "0 4px 14px rgba(20,23,21,.10)", "lg": "0 12px 32px rgba(20,23,21,.16)", "xl": "0 24px 64px rgba(20,23,21,.24)" },
    "dark":  { "sm": "0 1px 2px rgba(0,0,0,.4)", "md": "0 4px 14px rgba(0,0,0,.45)", "lg": "0 12px 32px rgba(0,0,0,.5)", "xl": "0 24px 64px rgba(0,0,0,.6)" }
  },
  "motion": {
    "duration": { "$type": "duration", "instant": 100, "fast": 160, "base": 240, "slow": 360, "slower": 600 },
    "easing": { "$type": "cubicBezier",
      "standard": [0.2, 0, 0, 1],
      "decelerate": [0.05, 0.7, 0.1, 1],
      "accelerate": [0.3, 0, 0.8, 0.15],
      "spring": [0.34, 1.56, 0.64, 1]
    }
  },
  "breakpoint": { "$type": "dimension", "sm": 375, "md": 768, "lg": 1280, "xl": 1440 },
  "layout": {
    "$type": "dimension",
    "container": 1280,
    "margin-sm": 16, "margin-md": 24, "margin-lg": 40,
    "gutter-sm": 12, "gutter-md": 16, "gutter-lg": 24,
    "columns-sm": 4, "columns-md": 8, "columns-lg": 12,
    "header": 72, "header-sm": 56,
    "tap-min": 44
  },
  "z": { "$type": "number", "base": 0, "sticky": 90, "header": 100, "fab": 110, "dropdown": 150, "sheet": 200, "modal": 300, "toast": 400 }
}
